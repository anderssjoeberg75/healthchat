# HealthChat MariaDB Environment Configuration Template
#
# Kopiera till en av dessa platser och fyll i värdena:
#   ~/.healthchat/db.env        (utveckling / desktop)
#   .env i projektroten          (utveckling - ligger i .gitignore)
#   /etc/healthchat/db.env       (drift, läses av healthchat_web.service)
#
# Sätt rättigheterna så att bara ägaren kan läsa filen:
#   chmod 600 <filen>
#
# Filen får ALDRIG committas. Denna .env.example innehåller därför inga
# riktiga värden - bara platshållare.

MARIADB_HOST=db.example.internal
MARIADB_PORT=3306
MARIADB_USER=healthchat
MARIADB_PASSWORD=
MARIADB_DB=healthchat

# --- Transportkryptering mot databasen (rekommenderas, se TLS-3 i board.md) ---
# Sökväg till CA-certifikatet som signerat MariaDB-serverns certifikat.
# Sätt MARIADB_REQUIRE_TLS=1 för att vägra ansluta utan TLS.
#MARIADB_SSL_CA=/etc/healthchat/ca.pem
#MARIADB_REQUIRE_TLS=1

# --- Timeouts (valfria, sekunder) ---
#MARIADB_CONNECT_TIMEOUT=5
#MARIADB_READ_TIMEOUT=30
#MARIADB_WRITE_TIMEOUT=30

# --- Webbsäkerhet (S-15 och TLS-2 i board.md) ---
# Tillåtna CORS-origins (kommaseparerad lista). Standard är http://localhost:8000,http://127.0.0.1:8000
#ALLOWED_ORIGINS=https://healthchat.example.se,http://localhost:8000

# Sätts cookien med Secure=True? Default är 1 (aktivt).
# Sätt COOKIE_SECURE=0 enbart för lokal utveckling över ren HTTP utan TLS/proxy.
#COOKIE_SECURE=1

# --- Datakällor: OAuth-callback (Strava, Withings, Fitbit) ---
# Publik bas-URL som callback-adresserna byggs av. Callback-URL:en blir
# <PUBLIC_BASE_URL>/api/datasources/<tjänst>/callback och måste anges exakt så
# i respektive utvecklarportal. Utan detta värde härleds adressen från inkommande
# request, vilket blir fel bakom en proxy som terminerar TLS.
#PUBLIC_BASE_URL=https://healthchat.example.se

# --- Lokal Ollama AI (används för Fråga Coachen-chatten) ---
OLLAMA_BASE_URL=http://192.168.107.15:11436
OLLAMA_MODEL=gemma4:12b


