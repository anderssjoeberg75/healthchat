# HealthChat MariaDB Environment Configuration Template
#
# Kopiera till en av dessa platser och fyll i värdena:
#   ~/.healthchat/db.env        (utveckling / desktop)
#   .env i projektroten          (utveckling - ligger i .gitignore)
#   /etc/healthchat/db.env       (drift, läses av healthchat_web.service)
#
# Sätt rättigheterna så att bara ägaren kan läsa filen:
#   chmod 600 <filen>
#
# Filen får ALDRIG committas. Denna .env.example innehåller därför inga
# riktiga värden - bara platshållare.

MARIADB_HOST=db.example.internal
MARIADB_PORT=3306
MARIADB_USER=healthchat
MARIADB_PASSWORD=
MARIADB_DB=healthchat

# --- Transportkryptering mot databasen (rekommenderas, se TLS-3 i board.md) ---
# Sökväg till CA-certifikatet som signerat MariaDB-serverns certifikat.
# Sätt MARIADB_REQUIRE_TLS=1 för att vägra ansluta utan TLS.
#MARIADB_SSL_CA=/etc/healthchat/ca.pem
#MARIADB_REQUIRE_TLS=1

# --- Timeouts (valfria, sekunder) ---
#MARIADB_CONNECT_TIMEOUT=5
#MARIADB_READ_TIMEOUT=30
#MARIADB_WRITE_TIMEOUT=30
