# Copy to .env and adjust before deploying.

# Public base URL. OAuth redirect URIs become <BASE_URL>/oauth/<service>/callback,
# so this must match what you register with Fitbit, Strava and Withings.
HEALTHCHAT_BASE_URL=https://healthchat.example.com

# Where per-user data (databases, tokens, chat history) is stored on the server.
HEALTHCHAT_DATA_DIR=/data

# Session signing secret. Leave empty to auto-generate one into the data directory.
HEALTHCHAT_SECRET_KEY=

# 1 = only the very first account can be created (invite-only deployment).
HEALTHCHAT_DISABLE_REGISTRATION=0

# 1 = mark the session cookie Secure (required when serving over HTTPS).
HEALTHCHAT_COOKIE_SECURE=1

# Days a login stays valid.
HEALTHCHAT_SESSION_TTL_DAYS=30
