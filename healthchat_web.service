[Unit]
Description=HealthChat FastAPI Web Application Service
After=network.target mariadb.service

[Service]
Type=simple
User=healthchat
WorkingDirectory=/opt/healthchat
Environment="PATH=/opt/healthchat/venv/bin"

# Databaskonfigurationen - inklusive lösenordet - läses ur en fil utanför
# git-repot. Skapa den en gång på servern:
#   sudo mkdir -p /etc/healthchat
#   sudo install -o healthchat -g healthchat -m 600 /dev/null /etc/healthchat/db.env
#   sudo -u healthchat editor /etc/healthchat/db.env
# Se .env.example för vilka nycklar som ska sättas.
#
# Lägg ALDRIG lösenord som Environment= här: unit-filen ligger i git, och
# `systemctl show healthchat_web` visar dessutom Environment= för alla
# användare på systemet. EnvironmentFile läses av systemd som root och
# exponeras inte på samma sätt.
EnvironmentFile=/etc/healthchat/db.env

# Appen lyssnar enbart på loopback. TLS termineras av Caddy på port 443,
# som proxar hit - se deploy/README.md och deploy/Caddyfile.
#
# --host 127.0.0.1 är en säkerhetsåtgärd, inte en detalj: så länge appen
# svarar på en utåtriktad port går det att kringgå TLS:en genom att ange
# portnumret.
#
# --proxy-headers får uvicorn att läsa X-Forwarded-Proto/-For från Caddy.
# Utan den ser appen varje request som http och loggar proxyns IP i stället
# för klientens.
#
# VIKTIGT vid uppgradering från en okrypterad uppsättning: installera inte
# den här filen förrän proxyn är uppe och verifierad. Ordningen står i
# deploy/README.md - görs stegen i fel ordning blir appen onåbar däremellan.
ExecStart=/opt/healthchat/venv/bin/uvicorn server:app \
          --host 127.0.0.1 --port 8001 --workers 4 \
          --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
